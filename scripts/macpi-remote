#!/usr/bin/env bash
# macpi-remote — point a TV remote at MacPi.
#
#   macpi-remote detect      what input hardware this box actually has
#   macpi-remote learn-ir    learn an IR remote (Roku simple remote, any NEC remote)
#   macpi-remote cec         drive the desktop from a TV remote over HDMI-CEC
#   macpi-remote help
#
# Reality check, because it matters: a Roku *streaming stick* remote is not
# Bluetooth. Roku "point anywhere" remotes talk to the stick over Wi-Fi Direct
# (802.11), so no amount of pairing will make one talk to a Pi. What does work:
#   * a Roku SIMPLE remote (the IR one) + a £1 IR receiver on the GPIO header
#   * any cheap USB "air mouse" / mini keyboard
#   * a Bluetooth HID remote (Fire TV remote, 8BitDo, generic media remote)
#   * a Roku TV remote when the Pi is plugged into that TV (HDMI-CEC)
#
set -u

SHARE=${MACPI_SHARE:-/usr/local/share/macpi}
IR_DEV=/dev/lirc0
KEYTABLE=/etc/rc_keymaps/macpi-roku
UNIT=/etc/systemd/system/macpi-ir.service

say()  { printf '%s\n' "$*"; }
head2() { printf '\n\033[1m%s\033[0m\n' "$*"; }

detect() {
  head2 "Input hardware"
  local model="unknown"
  [[ -r /proc/device-tree/model ]] && model=$(tr -d '\0' < /proc/device-tree/model)
  say "  board:            $model"

  if [[ -e "$IR_DEV" ]]; then
    say "  IR receiver:      present ($IR_DEV)"
    command -v ir-keytable >/dev/null && say "  ir-keytable:      $(ir-keytable --version 2>/dev/null | head -1)"
  else
    say "  IR receiver:      none — wire a TSOP38238 to GPIO17/3V3/GND and add"
    say "                    dtoverlay=gpio-ir,gpio_pin=17 to /boot/firmware/config.txt"
  fi

  if command -v cec-client >/dev/null; then
    say "  HDMI-CEC:         cec-utils installed"
  else
    say "  HDMI-CEC:         not installed (sudo apt install cec-utils)"
  fi

  if command -v bluetoothctl >/dev/null; then
    local n
    n=$(bluetoothctl devices 2>/dev/null | wc -l)
    say "  Bluetooth:        adapter ok, $n paired device(s)"
  else
    say "  Bluetooth:        bluetoothctl missing"
  fi

  say "  X input devices:"
  if command -v xinput >/dev/null; then
    xinput list --short 2>/dev/null | sed 's/^/    /'
  else
    say "    (install xinput to list them)"
  fi

  head2 "Will a Roku stick remote work?"
  say "  No. Roku point-anywhere remotes use Wi-Fi Direct, not Bluetooth or IR."
  say "  An IR Roku *simple* remote works once you've run: macpi-remote learn-ir"
}

learn_ir() {
  [[ -e "$IR_DEV" ]] || {
    say "No $IR_DEV — enable the GPIO IR overlay first:"
    say "  echo 'dtoverlay=gpio-ir,gpio_pin=17' | sudo tee -a /boot/firmware/config.txt"
    say "  sudo reboot"
    exit 1
  }
  command -v ir-keytable >/dev/null || { say "install ir-keytable (v4l-utils)"; exit 1; }

  head2 "Learning an IR remote"
  say "  Point the remote at the receiver. You have 25 seconds per button."
  say "  (Roku simple remote, or any NEC-style remote.)"
  say ""

  local out; out=$(mktemp)
  sudo ir-keytable -s rc0 -p all -t >"$out" 2>&1 &
  local tid=$!
  trap 'kill '"$tid"' 2>/dev/null; rm -f "$out"' EXIT
  sleep 1.5

  declare -A seen=()
  local -a pairs
  local spec
  local lines=( \
    "KEY_UP:Up" "KEY_DOWN:Down" "KEY_LEFT:Left" "KEY_RIGHT:Right" \
    "KEY_ENTER:OK" "KEY_BACK:Back" "KEY_HOME:Home" \
    "KEY_PLAYPAUSE:Play/Pause" "KEY_VOLUMEUP:Vol+" "KEY_VOLUMEDOWN:Vol-" )

  for spec in "${lines[@]}"; do
    local code="${spec%%:*}" label="${spec##*:}"
    printf '  %-12s : ' "$label"
    local off; off=$(stat -c%s "$out" 2>/dev/null || echo 0)
    local sc="" deadline=$((SECONDS + 25))
    while (( SECONDS < deadline )); do
      sc=$(tail -c +$((off + 1)) "$out" 2>/dev/null \
           | grep -oE 'scancode = (0x)?[0-9a-fA-F]+' \
           | sed 's/.*= //' | head -1)
      [[ -n "$sc" ]] && break
      sleep 0.15
    done
    if [[ -z "$sc" ]]; then
      printf 'skipped\n'
      continue
    fi
    [[ "$sc" != 0x* ]] && sc="0x$sc"
    if [[ -n "${seen[$sc]:-}" ]]; then
      printf '%s (duplicate, ignored)\n' "$sc"
      continue
    fi
    seen[$sc]=1
    pairs+=("$sc $code")
    printf '%s\n' "$sc"
    sleep 1.2
  done

  if (( ${#pairs[@]} == 0 )); then
    say ""
    say "Nothing captured. Check the wiring, then try: sudo ir-keytable -t"
    exit 1
  fi

  head2 "Writing keytable"
  sudo mkdir -p "$(dirname "$KEYTABLE")"
  {
    echo "# macpi-roku — generated by macpi-remote on $(date -I)"
    echo "# table macpi-roku, type: NEC"
    for p in "${pairs[@]}"; do echo "$p"; done
  } | sudo tee "$KEYTABLE" >/dev/null
  say "  $KEYTABLE  ($(printf '%s\n' "${pairs[@]}" | wc -l) keys)"

  sudo ir-keytable -c -w "$KEYTABLE" >/dev/null 2>&1
  say "  applied to $IR_DEV for this session"

  sudo tee "$UNIT" >/dev/null <<EOF
[Unit]
Description=MacPi IR keytable
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/ir-keytable -c -w $KEYTABLE
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable --now macpi-ir.service >/dev/null 2>&1
  say "  enabled at boot (macpi-ir.service)"
  say ""
  say "  Arrows move focus, OK = Enter, Back = Escape, Home = the dock."
}

cec_daemon() {
  command -v cec-client >/dev/null || { say "sudo apt install cec-utils"; exit 1; }
  say "Listening for HDMI-CEC keys (Ctrl-C to stop)..."
  # Roku TV remote -> desktop keys
  cec-client -d 1 -s "hdmi_cec" 2>&1 | while IFS= read -r line; do
    case "$line" in
      *"key pressed"*)
        case "$line" in
          *up*)        xdotool key Up ;;
          *down*)      xdotool key Down ;;
          *left*)      xdotool key Left ;;
          *right*)     xdotool key Right ;;
          *select*)    xdotool key Return ;;
          *"exit"*)    xdotool key Escape ;;
          *"root menu"*|*"home"*) xdotool key super ;;
          *"play"*)    xdotool key space ;;
        esac
        ;;
    esac
  done
}

case "${1:-detect}" in
  detect)    detect ;;
  learn-ir)  learn_ir ;;
  cec)       cec_daemon ;;
  help|*)    sed -n '2,20p' "$0" ;;
esac
